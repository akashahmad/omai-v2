# Copy to .env.local (local, no MicroVMs; `bun dev`) and .env.prod
# (Northflank MicroVMs; `bun dev:prod`). Both are git-ignored.
# README.md documents every variable. An empty value counts as unset.

# Cloudflare (Workers for Platforms + Cloudflare for SaaS custom hostnames)
OMAI_CLOUDFLARE_API_TOKEN=
OMAI_CLOUDFLARE_ACCOUNT_ID=

# VM provider: "local" (one omai serve process per project) or "northflank"
OMAI_VM_PROVIDER=local

# Northflank (with OMAI_VM_PROVIDER=northflank). Use project "omaiv2", never "omai".
OMAI_NORTHFLANK_API_TOKEN=
OMAI_NORTHFLANK_PROJECT=omaiv2
OMAI_NORTHFLANK_IMAGE=docker.io/jj123dev/omai-microvm:v1
OMAI_NORTHFLANK_PLAN=nf-compute-100-4
OMAI_NORTHFLANK_VOLUME_SIZE_GB=10

# Multi-user control plane and router
OMAI_APP_ORIGIN=http://localhost:4444
OMAI_ROUTER_URL=http://localhost:4200
OMAI_CONTROL_PLANE_URL=http://127.0.0.1:4101
OMAI_CONTROLPLANE_DATA_DIR=.omai-controlplane
OMAI_SIGNUP_ENABLED=false
# Unset: embedded Postgres (PGlite) under OMAI_CONTROLPLANE_DATA_DIR
OMAI_DATABASE_URL=
# Optional: also run the control plane database tests on this Postgres
OMAI_TEST_DATABASE_URL=
# Pausing idle VMs (milliseconds; these are the defaults)
OMAI_VM_IDLE_MS=120000
OMAI_VM_SWEEP_MS=15000
OMAI_VM_BUSY_FRESH_MS=30000
OMAI_VM_UNREACHABLE_GRACE_MS=60000
OMAI_VM_RECONCILE_MS=180000
# Reserve VMs booted ahead for each active user, so a new project opens at once. 0 (default) turns them off;
# set it only on the deployed control plane, since reserves are real, billed VMs
OMAI_VM_RESERVES_PER_USER=0
OMAI_VM_RESERVE_IDLE_MS=600000
OMAI_VM_RESERVES_MAX=20
# Encrypts users' own provider keys (32 bytes, base64); generated into the data dir when unset
OMAI_SECRETS_KEY=
# Ed25519 key pair, one-line PEM with \n escapes inside double quotes
OMAI_TOKEN_SIGNING_KEY=
OMAI_TOKEN_PUBLIC_KEY=

# Platform model provider keys (control plane only), e.g.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
